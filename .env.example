# Settings.from_env() reads these; examples/mcp_tool_server.py also accepts --env-file .env
# Every value is validated at startup. Defaults are the conservative ones.

# --- who the owner is (comma-separated) -------------------------------------------------
# Phone numbers need the + and country code; anything ambiguous is a startup error.
GUARDRAILS_OWNER_PHONES=+15550001111
GUARDRAILS_OWNER_EMAILS=owner@example.com
# Chat-platform user ids as channel:id pairs, e.g. slack:U0123ABCD
GUARDRAILS_OWNER_ACCOUNTS=

# --- time ----------------------------------------------------------------------------------
# IANA zone used to resolve "tomorrow at 9" and to count briefing days
GUARDRAILS_TIMEZONE=America/New_York

# --- multi-tenant backends -----------------------------------------------------------------
# The single tenant this deployment may address. Unset = tenant-scoped tools refuse.
GUARDRAILS_TENANT_ID=maple-bikes

# --- scheduling and approvals --------------------------------------------------------------
# Minimum gap between runs of any scheduled job, in minutes (5 is the floor)
GUARDRAILS_MIN_INTERVAL_MINUTES=5
# How long an approval request stays valid (1-168 hours)
GUARDRAILS_APPROVAL_TTL_HOURS=24
# Secret that signs approval requests, at least 32 bytes; keep it out of the approvals file
# and stable across restarts (rotating it voids pending requests). Generate it like the
# envelope key below. Required by JsonApprovalStore.
GUARDRAILS_APPROVAL_KEY=

# --- MCP tool server -----------------------------------------------------------------------
# HMAC key shared by your gateway and the tool server, at least 32 bytes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GUARDRAILS_ENVELOPE_KEY=
